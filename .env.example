# Copy this file to ".env" and fill in your values. Never commit ".env".
PORT=3000
# Long random text. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Set to 1 when the site runs on HTTPS
COOKIE_SECURE=0

# Email (sends verification codes and task alerts). Use EITHER option A or B.
# Option A: your own Gmail (easiest). Turn on 2-Step Verification, then create an "App password" at
#   https://myaccount.google.com/apppasswords and paste the 16 letters below (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Option B: Resend. Get a key at resend.com (needs a verified domain to email other people)
RESEND_API_KEY=
MAIL_FROM=ClassMind <noreply@your-domain.com>

# OpenAI API Key (powers Askora and AI Video Analysis)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (backup / secondary AI engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Speech-to-text with speaker labels. Get a key at assemblyai.com
ASSEMBLYAI_API_KEY=

# Summary, quiz, flashcards, tasks, Ask AI. Get a key at console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

MAX_UPLOAD_MB=2048
CONCURRENCY=2
